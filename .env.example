# Copy to .env and fill in. Get these at https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Optional shortcut instead of the two above: a token generated in the dashboard
PINTEREST_ACCESS_TOKEN=

# Ollama
VISION_MODEL=gemma3:4b
CAPTION_MODEL=llama3.1:8b
CAPTION_STYLE=friendly, short, natural; no clickbait, at most one emoji
